# Choose ONE provider: ollama (local), groq (free key) or huggingface (free key)
PROVIDER=ollama

# Option A - Ollama (local, no key needed)
MODEL=qwen2.5:1.5b

# Option B - Groq: get a free key at https://console.groq.com/keys
# PROVIDER=groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# MODEL=openai/gpt-oss-20b

# Option C - Hugging Face: get a free token at https://huggingface.co/settings/tokens
# PROVIDER=huggingface
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# MODEL=openai/gpt-oss-20b
